# Configure a real RTSP camera before running the default Compose stack.
VIDEO_SOURCE_TYPE=rtsp
VIDEO_SOURCE=
CAMERA_ID=camera-1
FRAME_RATE=2

# Suppress repeated events for the same camera and label during this interval.
EVENT_RULES_COOLDOWN_SECONDS=10.0

# For the optional simulator, run Compose with --profile simulator and use:
# VIDEO_SOURCE=rtsp://rtsp-simulator:8554/camera-1

# For a recorded MP4, use:
# VIDEO_SOURCE_TYPE=file
# VIDEO_SOURCE=/media/sample.mp4

# Epic 4 Foundry Local runtime settings.
# Use mock for CPU-only contract smoke tests; use onnx with fetched artifacts.
FOUNDRY_EXECUTION_PROVIDER=CUDAExecutionProvider
FOUNDRY_RUNTIME_MODE=onnx
FOUNDRY_PORT=8000