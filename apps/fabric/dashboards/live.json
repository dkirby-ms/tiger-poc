, Plant = plantId, Case = subjectId, IdentifiedArea = positionId, Camera = sourceId, EventId = eventId\n| top 500 by Timestamp desc","id":"f36c8264-f362-47e9-9954-000000000010","usedVariables":["_endTime","_startTime"]},{"dataSource":{"kind":"inline","dataSourceId":"50be4fa0-851c-4631-9896-000000000003"},"text":"CurrentPositionOccupancy\n| summarize Positions = count()","id":"f36c8264-f362-47e9-9954-000000000001","usedVariables":[]},{"dataSource":{"kind":"inline","dataSourceId":"50be4fa0-851c-4631-9896-000000000003"},"text":"CurrentPositionOccupancy\n| summarize Occupied = countif(isOccupied == true)","id":"f36c8264-f362-47e9-9954-000000000002","usedVariables":[]},{"dataSource":{"kind":"inline","dataSourceId":"50be4fa0-851c-4631-9896-000000000003"},"text":"CurrentPositionOccupancy\n| summarize Empty = countif(isOccupied == false)","id":"f36c8264-f362-47e9-9954-000000000003","usedVariables":[]},{"dataSource":{"kind":"inline","dataSourceId":"50be4fa0-851c-4631-9896-000000000003"},"text":"CurrentPositionOccupancy\n| summarize TotalPositions = count(), OccupiedCount = countif(isOccupied == true)\n| project Rate = iff(TotalPositions == 0, real(null), round(100.0 * OccupiedCount / TotalPositions, 1))","id":"f36c8264-f362-47e9-9954-000000000004","usedVariables":[]},{"dataSource":{"kind":"inline","dataSourceId":"50be4fa0-851c-4631-9896-000000000003"},"text":"CurrentPositionOccupancy\n| join kind=leftouter (MonitoredPositions | join kind=inner Cells on cellId | join kind=inner Plants on plantId) on $left.subjectId == $right.positionId\n| project Plant = plantName, Cell = cellName, Position = positionName, SubjectId = subjectId, ObservationType = observationType, Status = iff(isOccupied, 'Occupied', 'Empty'), Confidence = confidence, LastCaptured = capturedAt, Camera = sourceId\n| order by Cell asc, Position asc","id":"f36c8264-f362-47e9-9954-000000000005","usedVariables":[]},{"dataSource":{"kind":"inline","dataSourceId":"50be4fa0-851c-4631-9896-000000000003"},"text":"ConfirmedPresenceEvents\n| where capturedAt between (_startTime .. _endTime)\n| summarize arg_max(publishedAt, *) by eventId\n| project Timestamp = capturedAt, Subject = subjectId, ObservationType = observationType, Action = iff(isOccupied, 'Present (Occupied)', 'Absent (Empty)'), Confidence = confidence, Model = model\n| top 500 by Timestamp desc","id":"f36c8264-f362-47e9-9954-000000000006","usedVariables":["_endTime","_startTime"]},{"dataSource":{"kind":"inline","dataSourceId":"50be4fa0-851c-4631-9896-000000000003"},"text":"ProcessEventsRaw\n| extend IngestedAt = ingestion_time()\n| where IngestedAt between (_startTime .. _endTime)\n| extend LatencySeconds = datetime_diff('millisecond', IngestedAt, capturedAt) / 1000.0\n| summarize AvgLatencySeconds = avg(LatencySeconds) by bin(IngestedAt, 1m)\n| order by IngestedAt asc","id":"f36c8264-f362-47e9-9954-000000000007","usedVariables":["_endTime","_startTime"]}],"embeddedApps":[]}