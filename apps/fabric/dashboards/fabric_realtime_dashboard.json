      "description": "Capture time for transitions; ingestion time for latency. Summary and position state show the latest confirmed evidence across all time, not camera health.",
      "beginVariableName": "_startTime",
      "endVariableName": "_endTime",
      "defaultValue": { "kind": "dynamic", "count": 1, "unit": "hours" },
