  "dataSources": [
    {
      "kind": "manual-kusto",
      "name": "Configure Tiger KQL Database",
      "clusterUri": "https://example.invalid",
      "database": "REPLACE_WITH_KQL_DATABASE",
      "id": "50be4fa0-851c-4631-9896-000000000003"
    }
  ],
  "pages": [
    { "name": "Digital Twin", "id": "50be4fa0-851c-4631-9896-000000000005" },
    { "name": "Position Overview", "id": "50be4fa0-851c-4631-9896-000000000001" },
    { "name": "QR Case Identifications", "id": "50be4fa0-851c-4631-9896-000000000004" }
  ],
  "queries": [
    {
      "id": "f36c8264-f362-47e9-9954-000000000011",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": [],
      "text": "let entities = TigerTwinEntities() | summarize Entities=count(), Cases=countif(EntityType == 'Case');\nlet relationships = toscalar(TigerTwinRelationships() | count);\nlet observations = toscalar(TigerTwinCaseHistory() | count);\nentities\n| extend Relationships=relationships, CaseObservations=observations\n| extend Status=case(Entities == 0, 'Twin not populated', Cases == 0, 'No case twins mapped', Relationships == 0, 'No twin relationships mapped', CaseObservations == 0, 'No case observations mapped', 'Twin output available')"
    },
    {
      "id": "f36c8264-f362-47e9-9954-000000000012",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": [],
      "text": "TigerTwinCaseLocations()\n| extend ObservationAge=now() - LastObservedAt\n| order by CaseId asc"
    },
    {
      "id": "f36c8264-f362-47e9-9954-000000000013",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": ["_startTime", "_endTime"],
      "text": "TigerTwinCaseHistory()\n| where LastObservedAt between (_startTime .. _endTime)\n| project CaseId, LastObservedAt, LastObservedArea, Camera, EventIds, ObservationStatus\n| top 500 by LastObservedAt desc"
    },
    {
      "id": "f36c8264-f362-47e9-9954-000000000008",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": ["_startTime", "_endTime"],
      "text": "BoxIdentificationEvents\n| where capturedAt between (_startTime .. _endTime)\n| summarize by plantId, subjectId\n| summarize Cases = count()"
    },
    {
      "id": "f36c8264-f362-47e9-9954-000000000009",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": [],
      "text": "LastCaseIdentification\n| project Plant = plantId, Case = subjectId, LastIdentifiedArea = positionId, LastIdentifiedAt = capturedAt, Camera = sourceId\n| order by LastIdentifiedAt desc"
    },
    {
      "id": "f36c8264-f362-47e9-9954-000000000010",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": ["_startTime", "_endTime"],
      "text": "BoxIdentificationEvents\n| where capturedAt between (_startTime .. _endTime)\n| summarize arg_max(publishedAt, *) by eventId\n| project Timestamp = capturedAt, Plant = plantId, Case = subjectId, IdentifiedArea = positionId, Camera = sourceId, EventId = eventId\n| top 500 by Timestamp desc"
    },
    {
      "id": "f36c8264-f362-47e9-9954-000000000001",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": [],
      "text": "CurrentPositionOccupancy\n| summarize Positions = count()"
    },
    {
      "id": "f36c8264-f362-47e9-9954-000000000002",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": [],
      "text": "CurrentPositionOccupancy\n| summarize Occupied = countif(isOccupied == true)"
    },
    {
      "id": "f36c8264-f362-47e9-9954-000000000003",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": [],
      "text": "CurrentPositionOccupancy\n| summarize Empty = countif(isOccupied == false)"
    },
    {
      "id": "f36c8264-f362-47e9-9954-000000000004",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": [],
      "text": "CurrentPositionOccupancy\n| summarize TotalPositions = count(), OccupiedCount = countif(isOccupied == true)\n| project Rate = iff(TotalPositions == 0, real(null), round(100.0 * OccupiedCount / TotalPositions, 1))"
    },
    {
      "id": "f36c8264-f362-47e9-9954-000000000005",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": [],
      "text": "CurrentPositionOccupancy\n| join kind=leftouter (MonitoredPositions | join kind=inner Cells on cellId | join kind=inner Plants on plantId) on $left.subjectId == $right.positionId\n| project Plant = plantName, Cell = cellName, Position = positionName, SubjectId = subjectId, ObservationType = observationType, Status = iff(isOccupied, 'Occupied', 'Empty'), Confidence = confidence, LastCaptured = capturedAt, Camera = sourceId\n| order by Cell asc, Position asc"
    },
    {
      "id": "f36c8264-f362-47e9-9954-000000000006",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": ["_startTime", "_endTime"],
      "text": "ConfirmedPresenceEvents\n| where capturedAt between (_startTime .. _endTime)\n| summarize arg_max(publishedAt, *) by eventId\n| project Timestamp = capturedAt, Subject = subjectId, ObservationType = observationType, Action = iff(isOccupied, 'Present (Occupied)', 'Absent (Empty)'), Confidence = confidence, Model = model\n| top 500 by Timestamp desc"
    },
    {
      "id": "f36c8264-f362-47e9-9954-000000000007",
      "dataSource": { "kind": "inline", "dataSourceId": "50be4fa0-851c-4631-9896-000000000003" },
      "usedVariables": ["_startTime", "_endTime"],
      "text": "ProcessEventsRaw\n| extend IngestedAt = ingestion_time()\n| where IngestedAt between (_startTime .. _endTime)\n| extend LatencySeconds = datetime_diff('millisecond', IngestedAt, capturedAt) / 1000.0\n| summarize AvgLatencySeconds = avg(LatencySeconds) by bin(IngestedAt, 1m)\n| order by IngestedAt asc"
    }
  ],
  "embeddedApps": []
}
