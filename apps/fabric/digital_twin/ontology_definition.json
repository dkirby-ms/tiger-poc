{
  "name": "ManufacturingPlantTwin",
  "version": "1.0.0",
  "description": "Design reference for manually configuring Plant, Cell and MonitoredPosition entities in Fabric; not an official import format",
  "entityTypes": [
    {
      "id": "Plant",
      "displayName": "Manufacturing Plant",
      "description": "Physical factory facility",
      "properties": [
        { "name": "plantId", "type": "string", "isPrimaryKey": true },
        { "name": "plantName", "type": "string" },
        { "name": "location", "type": "string" }
      ]
    },
    {
      "id": "Cell",
      "displayName": "Manufacturing Cell",
      "description": "Work cell or robotic station inside a plant",
      "properties": [
        { "name": "cellId", "type": "string", "isPrimaryKey": true },
        { "name": "cellName", "type": "string" },
        { "name": "lineType", "type": "string" }
      ]
    },
    {
      "id": "MonitoredPosition",
      "displayName": "Monitored Position",
      "description": "Object or pallet region identified by detect subjectId",
      "properties": [
        { "name": "positionId", "type": "string", "isPrimaryKey": true },
        { "name": "positionName", "type": "string" },
        { "name": "isOccupied", "type": "boolean" },
        { "name": "confidence", "type": "double" },
        { "name": "observationType", "type": "string" },
        { "name": "lastObservedTimestamp", "type": "datetime" },
        { "name": "monitoredSourceId", "type": "string" }
      ]
    },
    {
      "id": "Case",
      "displayName": "Inventory Case",
      "description": "QR-labeled case with identification history, not inferred current presence",
      "properties": [
        { "name": "caseId", "type": "string", "isPrimaryKey": true },
        { "name": "plantId", "type": "string" },
        { "name": "lastIdentifiedArea", "type": "string" },
        { "name": "lastIdentifiedAt", "type": "datetime" },
        { "name": "lastIdentifiedSource", "type": "string" },
        { "name": "observationType", "type": "string" },
        { "name": "subjectId", "type": "string" }
      ]
    }
  ],
  "relationshipTypes": [
    {
      "id": "containsCell",
      "displayName": "Contains Cell",
      "sourceEntityType": "Plant",
      "targetEntityType": "Cell"
    },
    {
      "id": "monitorsPosition",
      "displayName": "Monitors Position",
      "sourceEntityType": "Cell",
      "targetEntityType": "MonitoredPosition"
    },
    {
      "id": "registersCase",
      "displayName": "Registers Case",
      "sourceEntityType": "Plant",
      "targetEntityType": "Case"
    }
  ],
  "telemetryBindings": [
    {
      "targetEntityType": "MonitoredPosition",
      "sourceStream": "CurrentPositionOccupancy",
      "mappingRule": {
        "matchProperty": "subjectId",
        "entityPrimaryKey": "positionId",
        "propertyUpdates": {
          "isOccupied": "isOccupied",
          "confidence": "confidence",
          "observationType": "observationType",
          "lastObservedTimestamp": "capturedAt"
        }
      }
    },
    {
      "targetEntityType": "Case",
      "sourceStream": "LastCaseIdentification",
      "historyStream": "BoxIdentificationEvents",
      "observationTypes": ["BoxIdentified"],
      "mappingRule": {
        "matchProperty": "subjectId",
        "entityPrimaryKey": "caseId",
        "propertyUpdates": {
          "lastIdentifiedArea": "positionId",
          "lastIdentifiedAt": "capturedAt",
          "lastIdentifiedSource": "sourceId",
          "observationType": "observationType",
          "subjectId": "subjectId"
        }
      }
    }
  ]
}
