{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CuratedProcessEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "subjectId",
    "stationId",
    "siteId",
    "deviceId",
    "ontologyVersion",
    "sequence",
    "observedAt",
    "emittedAt",
    "state",
    "confidence",
    "sourceRuntime",
    "sourceModel"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "ProcessStateChanged" },
    "subjectId": { "type": "string", "minLength": 1 },
    "stationId": { "type": "string", "minLength": 1 },
    "siteId": { "type": "string", "minLength": 1 },
    "deviceId": { "type": "string", "minLength": 1 },
    "ontologyVersion": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "emittedAt": { "type": "string", "format": "date-time" },
    "state": { "enum": ["blocked", "clear"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sourceRuntime": { "type": "string", "minLength": 1 },
    "sourceModel": { "type": "string", "minLength": 1 },
    "traceparent": { "type": ["string", "null"] }
  }
}