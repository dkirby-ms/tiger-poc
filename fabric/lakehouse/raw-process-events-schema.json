{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RawProcessEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "subjectId",
    "subjectType",
    "siteId",
    "deviceId",
    "ontologyVersion",
    "sequence",
    "observedAt",
    "emittedAt",
    "state",
    "confidence",
    "sourceRuntime",
    "sourceModel",
    "eventstreamEnqueuedAt",
    "eventstreamPartitionId",
    "eventstreamOffset"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string" },
    "subjectId": { "type": "string", "minLength": 1 },
    "subjectType": { "type": "string", "minLength": 1 },
    "siteId": { "type": "string", "minLength": 1 },
    "deviceId": { "type": "string", "minLength": 1 },
    "ontologyVersion": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer" },
    "observedAt": { "type": "string", "format": "date-time" },
    "emittedAt": { "type": "string", "format": "date-time" },
    "state": { "type": "string" },
    "confidence": { "type": "number" },
    "sourceRuntime": { "type": "string", "minLength": 1 },
    "sourceModel": { "type": "string", "minLength": 1 },
    "traceparent": { "type": ["string", "null"] },
    "eventstreamEnqueuedAt": { "type": "string", "format": "date-time" },
    "eventstreamPartitionId": { "type": "string" },
    "eventstreamOffset": { "type": "string" }
  }
}