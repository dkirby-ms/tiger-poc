# Copy to .env locally. Use absolute Linux paths when Docker runs in WSL.
# Never put the camera URL or credentials in this file.
MODEL_FILE=/absolute/path/to/trusted-model.pt
YOLO_MODEL_SHA256=replace-with-64-character-sha256
RTSP_SECRET_FILE=/absolute/path/to/rtsp-url.txt
OUTPUT_DIR=/absolute/path/to/output
CAMERA_ID=camera-01
CONFIDENCE=0.5
FRAME_STRIDE=5
# 0 processes continuously; use a positive number for a bounded run.
MAX_FRAMES=0
